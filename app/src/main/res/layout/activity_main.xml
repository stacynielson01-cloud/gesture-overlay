<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gesture Overlay"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floating button gesture controller"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <!-- Status Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERMISSIONS"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_overlay_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlay: Checking..."
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_enable_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_enable_overlay"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/teal_200"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_accessibility_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accessibility: Checking..."
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_enable_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_enable_accessibility"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/teal_200"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Overlay Control -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVERLAY CONTROL"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_start_overlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_start_overlay"
            android:textSize="15sp"
            android:enabled="false"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <Button
            android:id="@+id/btn_stop_overlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_stop_overlay"
            android:textSize="15sp"
            android:layout_marginBottom="32dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="#FFEF5350"/>

        <!-- Instructions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A42A5F5"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How to use"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Grant overlay permission above\n2. Enable Accessibility Service (search for Gesture Overlay Controller)\n3. Tap Launch Overlay — floating buttons appear\n4. Drag buttons anywhere on screen\n5. Press a button to fire its gesture\n\nDefault buttons:\n• Swipe Up — single upward swipe\n• Burst x3 — three parallel swipes\n• Loop — repeating swipe every 800ms"
                    android:textColor="#CCffffff"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
